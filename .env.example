# ─────────────────────────────────────────────────────────────────────────────
# Universal Intelligence Lab — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1 (Free MVP) ───────────────────────────────────────────────────────
# Platforms: Supabase (DB) · Qdrant Cloud (vectors) · Upstash (Redis) · R2 (files)

# ── Database — Supabase ───────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → Database → Connection string
# Use Transaction Mode pooler (port 6543) for the running app.
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Cache — Upstash Redis ─────────────────────────────────────────────────────
# Get from: console.upstash.com → Redis → Connect → .env tab
# Upstash uses TLS — the URL starts with rediss:// (double s)
REDIS_URL=rediss://default:[token]@[host].upstash.io:6379

# ── Vector DB — Qdrant Cloud ──────────────────────────────────────────────────
# Get from: cloud.qdrant.io → Cluster → API Keys
QDRANT_HOST=xyz.us-east-1.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM — OpenAI-compatible ───────────────────────────────────────────────────
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── File Storage — Cloudflare R2 ──────────────────────────────────────────────
# Get from: Cloudflare dashboard → R2 → Manage API Tokens
# Set USE_R2_STORAGE=true after creating the bucket; false = local disk (default)
USE_R2_STORAGE=false
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=uil-papers
# R2_ENDPOINT_URL=   # leave blank — auto-derived from R2_ACCOUNT_ID

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to your Render service URL after deploying
NEXT_PUBLIC_API_URL=https://uil-backend.onrender.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Local docker-compose overrides (only used when running docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pharalab
POSTGRES_USER=phara

# ─────────────────────────────────────────────────────────────────────────────
# HF Spaces single-container mode (set as Space Secrets)
# ─────────────────────────────────────────────────────────────────────────────
# USE_SQLITE=true
# QDRANT_IN_MEMORY=true
